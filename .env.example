# Copy to .env and adjust. Docker Compose reads .env automatically.

# Persistence is chosen by the Compose files, not by this file:
#   named volumes (default):  docker compose up -d
#   host folders in ./data:   docker compose -f compose.yaml -f compose.bind.yaml up -d
# (COMPOSE_FILE can select the same chain, but its path separator differs
# between platforms, so copy the explicit -f form instead.)

# Image reference. Defaults to the published image; pin a fixed tag such as
# nipakke/nanobot:0.4.2-20261123-abc1234 to stop following `latest`.
NANOBOT_IMAGE=nipakke/nanobot:latest

# WebUI token. Only applied when config.json is first created.
NANOBOT_WEB_TOKEN=

# Comma/space separated pixi packages, each installed into its own global env.
# Example: jq,ripgrep
EXTRA_PIXI_PACKAGES=

# Comma/space separated nanobot channels whose Python dependencies are
# installed into /app/.venv at startup. Failures are non-fatal, and the wheels
# are cached in /data/cache/uv.
# Example: NANOBOT_CHANNELS=discord,telegram
NANOBOT_CHANNELS=

# Container timezone (e.g. Europe/Budapest).
TZ=UTC

# WebUI bind address and port published on the host.
# Set NANOBOT_WEB_BIND=127.0.0.1 to restrict the plaintext WebUI to localhost.
NANOBOT_WEB_BIND=0.0.0.0
NANOBOT_WEB_PORT=8765

# Host-side port for the gateway health endpoint. This moves only the
# published port; the container side follows NANOBOT_HEALTH_PORT.
NANOBOT_HEALTH_HOST_PORT=18790

# Container-side health port and healthcheck port. Change this only when
# gateway.port in config.json is changed to match.
NANOBOT_HEALTH_PORT=18790

# Build-only args, used by compose.build.yaml (local builds).
# Note: Docker Compose reads .env directly; do not `source .env` in bash
# because UID is a readonly bash variable.
# Local build tag (compose.build.yaml), kept apart from NANOBOT_IMAGE.
#NANOBOT_BUILD_IMAGE=nanobot-pixi:local
# Version pins live in the Dockerfile (kept current by Renovate). Set these
# only to build a specific other version; a stale value here overrides the
# Dockerfile on every local build.
#NANOBOT_VERSION=
#PIXI_VERSION=
#BREW_VERSION=
#BREW_COMMIT=
BUNDLE_TUI=0
UID=1000
GID=1000
