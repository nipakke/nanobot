# Copy to .env and adjust. Docker Compose reads .env automatically.

# Published image tag. Pin a fixed tag (e.g. nipakke/nanobot:0.4.2-20261123-abc1234)
# to stop following `latest`.
NANOBOT_IMAGE=nipakke/nanobot:latest

# WebUI password. Applied only when config.json is first created; leave empty to
# generate a random password printed in the startup logs.
NANOBOT_WEB_TOKEN=

# Container timezone (e.g. Europe/Budapest).
TZ=UTC

# Optional pixi packages installed at startup, comma or space separated (e.g. jq,ripgrep).
EXTRA_PIXI_PACKAGES=

# Optional messaging channels to pre-install on startup (e.g. discord,telegram).
# See docs/configuration.md for the full list of channel names.
NANOBOT_CHANNELS=
