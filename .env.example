# Copy to .env and adjust. Docker Compose reads .env automatically.

# Image reference. Portainer users point this at their registry path.
NANOBOT_IMAGE=nanobot-pixi:0.4.2

# WebUI token. Only applied when config.json is first created.
NANOBOT_WEB_TOKEN=

# Comma/space separated pixi packages, each installed into its own global env.
# Example: jq,ripgrep
EXTRA_PIXI_PACKAGES=

# Container timezone (e.g. Europe/Budapest).
TZ=UTC

# WebUI port published on the host.
NANOBOT_WEB_PORT=8765

# Host-side port for the gateway health endpoint. This moves only the
# published port; the container side stays 18790.
NANOBOT_HEALTH_HOST_PORT=18790

# Container-side health port and healthcheck port. Change this only when
# gateway.port in config.json is changed to match.
NANOBOT_HEALTH_PORT=18790

# Build-only args, used by compose.build.yaml (local builds).
NANOBOT_VERSION=0.4.2
PIXI_VERSION=v0.84.2
UID=1000
GID=1000
